            "name": "Gerente",
            "dataType": "string",
            "lineageTag": "52cc701b-4952-4973-bb96-9836b94103e1",
            "sourceColumn": "Gerente",
            "summarizeBy": "none"
          },
          {
            "name": "ColaboradoresDiretos",
            "dataType": "int64",
            "lineageTag": "ecac20fe-a0df-4361-9c4a-2a70a1c4ed79",
            "sourceColumn": "ColaboradoresDiretos",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "f818a63a-b716-4355-8034-82831cdc8e0c",
        "partitions": [
          {
            "name": "ManagerCounts",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    ComGerente = Table.SelectRows(Employees,each [ManagerId] <> null),",
                "    Agrupa = Table.Group(ComGerente,{\"ManagerId\",\"Gerente\"},{{\"ColaboradoresDiretos\",each Table.RowCount(_),Int64.Type}})",
                "in Agrupa"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Quality",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Verificacao",
            "dataType": "string",
            "lineageTag": "46287795-171b-4875-bee1-6dc9f6c86301",
            "sourceColumn": "Verificacao",
            "summarizeBy": "none"
          },
          {
            "name": "Ocorrencias",
            "dataType": "int64",
            "lineageTag": "650e64d1-3dac-474b-9325-7d0ac606898f",
            "sourceColumn": "Ocorrencias",
            "summarizeBy": "sum"
          },
          {
            "name": "Interpretacao",
            "dataType": "string",
            "lineageTag": "a54e843a-ca79-4dbe-8c2f-66ed848f9ef4",
            "sourceColumn": "Interpretacao",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "285d19a3-1c03-46d8-8e0b-1bfbe70e5e34",
        "partitions": [
          {
            "name": "Quality",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Resultado = #table(type table [Verificacao=text, Ocorrencias=Int64.Type, Interpretacao=text], {",
                "        {\"Colaboradores sem superior\",Table.RowCount(Table.SelectRows(Employees,each [ManagerId]=null)),\"James E Borg: topo da hierarquia; preservar nulo\"},",
                "        {\"Superior nao localizado\",Table.RowCount(Table.SelectRows(Employees,each [ManagerId]<>null and [Gerente]=null)),\"Zero esperado: referencias validas\"},",
                "        {\"Departamento sem gerente\",Table.RowCount(Table.SelectRows(Departments,each [ManagerId]=null or [Gerente]=null)),\"Nenhuma imputacao necessaria\"},",
                "        {\"Alocacoes com zero horas\",Table.RowCount(Table.SelectRows(Assignments,each [Horas]=0)),\"Preservar e sinalizar; nao inventar horas\"},",
                "        {\"Horas nulas ou negativas\",Table.RowCount(Table.SelectRows(Assignments,each [Horas]=null or [Horas]<0)),\"Zero esperado\"},",
                "        {\"IDs de colaborador duplicados\",Table.RowCount(Employees)-Table.RowCount(Table.Distinct(Employees,{\"EmployeeId\"})),\"Zero esperado\"}",
                "    })",
                "in Resultado"
              ],
              "type": "m"
            }
          }
        ]
      },
