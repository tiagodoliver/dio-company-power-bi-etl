    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "raw_employee",
        "expression": [
          "let",
          "    Fonte = #table({\"Fname\", \"Minit\", \"Lname\", \"Ssn\", \"Bdate\", \"Address\", \"Sex\", \"Salary\", \"Super_ssn\", \"Dno\"}, {",
          "        {\"John\", \"B\", \"Smith\", \"123456789\", \"1965-01-09\", \"731-Fondren-Houston-TX\", \"M\", 30000, \"333445555\", 5},",
          "        {\"Franklin\", \"T\", \"Wong\", \"333445555\", \"1955-12-08\", \"638-Voss-Houston-TX\", \"M\", 40000, \"888665555\", 5},",
          "        {\"Alicia\", \"J\", \"Zelaya\", \"999887777\", \"1968-01-19\", \"3321-Castle-Spring-TX\", \"F\", 25000, \"987654321\", 4},",
          "        {\"Jennifer\", \"S\", \"Wallace\", \"987654321\", \"1941-06-20\", \"291-Berry-Bellaire-TX\", \"F\", 43000, \"888665555\", 4},",
          "        {\"Ramesh\", \"K\", \"Narayan\", \"666884444\", \"1962-09-15\", \"975-Fire-Oak-Humble-TX\", \"M\", 38000, \"333445555\", 5},",
          "        {\"Joyce\", \"A\", \"English\", \"453453453\", \"1972-07-31\", \"5631-Rice-Houston-TX\", \"F\", 25000, \"333445555\", 5},",
          "        {\"Ahmad\", \"V\", \"Jabbar\", \"987987987\", \"1969-03-29\", \"980-Dallas-Houston-TX\", \"M\", 25000, \"987654321\", 4},",
          "        {\"James\", \"E\", \"Borg\", \"888665555\", \"1937-11-10\", \"450-Stone-Houston-TX\", \"M\", 55000, null, 1}",
          "    }),",
          "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Fname\", type text}, {\"Minit\", type text}, {\"Lname\", type text}, {\"Ssn\", type text}, {\"Bdate\", type text}, {\"Address\", type text}, {\"Sex\", type text}, {\"Salary\", type number}, {\"Super_ssn\", type text}, {\"Dno\", type number}})",
          "in",
          "    Tipos"
        ],
        "kind": "m",
        "lineageTag": "3e3dfb84-9db9-434d-9578-9b6984403871"
      },
      {
        "name": "raw_departament",
        "expression": [
          "let",
          "    Fonte = #table({\"Dname\", \"Dnumber\", \"Mgr_ssn\", \"Mgr_start_date\", \"Dept_create_date\"}, {",
          "        {\"Research\", 5, \"333445555\", \"1988-05-22\", \"1986-05-22\"},",
          "        {\"Administration\", 4, \"987654321\", \"1995-01-01\", \"1994-01-01\"},",
          "        {\"Headquarters\", 1, \"888665555\", \"1981-06-19\", \"1980-06-19\"}",
          "    }),",
          "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Dname\", type text}, {\"Dnumber\", type number}, {\"Mgr_ssn\", type text}, {\"Mgr_start_date\", type text}, {\"Dept_create_date\", type text}})",
          "in",
          "    Tipos"
        ],
        "kind": "m",
        "lineageTag": "0571d073-c5c0-41ee-bd37-b25585be1b0e"
      },
      {
        "name": "raw_dept_locations",
        "expression": [
          "let",
          "    Fonte = #table({\"Dnumber\", \"Dlocation\"}, {",
          "        {1, \"Houston\"},",
          "        {4, \"Stafford\"},",
          "        {5, \"Bellaire\"},",
          "        {5, \"Sugarland\"},",
          "        {5, \"Houston\"}",
          "    }),",
          "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Dnumber\", type number}, {\"Dlocation\", type text}})",
          "in",
          "    Tipos"
        ],
        "kind": "m",
        "lineageTag": "1636fe1a-356a-47ea-86af-26f28042dc03"
      },
      {
        "name": "raw_project",
        "expression": [
          "let",
          "    Fonte = #table({\"Pname\", \"Pnumber\", \"Plocation\", \"Dnum\"}, {",
          "        {\"ProductX\", 1, \"Bellaire\", 5},",
          "        {\"ProductY\", 2, \"Sugarland\", 5},",
          "        {\"ProductZ\", 3, \"Houston\", 5},",
          "        {\"Computerization\", 10, \"Stafford\", 4},",
          "        {\"Reorganization\", 20, \"Houston\", 1},",
          "        {\"Newbenefits\", 30, \"Stafford\", 4}",
          "    }),",
          "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Pname\", type text}, {\"Pnumber\", type number}, {\"Plocation\", type text}, {\"Dnum\", type number}})",
          "in",
          "    Tipos"
        ],
        "kind": "m",
        "lineageTag": "46d31144-22e2-451c-92f6-183a7c5bae57"
      },
      {
        "name": "raw_works_on",
        "expression": [
          "let",
          "    Fonte = #table({\"Essn\", \"Pno\", \"Hours\"}, {",
          "        {\"123456789\", 1, 32.5},",
          "        {\"123456789\", 2, 7.5},",
          "        {\"666884444\", 3, 40},",
          "        {\"453453453\", 1, 20},",
          "        {\"453453453\", 2, 20},",
          "        {\"333445555\", 2, 10},",
          "        {\"333445555\", 3, 10},",
          "        {\"333445555\", 10, 10},",
          "        {\"333445555\", 20, 10},",
          "        {\"999887777\", 30, 30},",
          "        {\"999887777\", 10, 10},",
          "        {\"987987987\", 10, 35},",
          "        {\"987987987\", 30, 5},",
          "        {\"987654321\", 30, 20},",
          "        {\"987654321\", 20, 15},",
          "        {\"888665555\", 20, 0}",
          "    }),",
          "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Essn\", type text}, {\"Pno\", type number}, {\"Hours\", type number}})",
          "in",
          "    Tipos"
        ],
        "kind": "m",
        "lineageTag": "b2d1587f-325f-499f-a365-56cab894eab7"
      },
      {
        "name": "raw_dependent",
        "expression": [
          "let",
          "    Fonte = #table({\"Essn\", \"Dependent_name\", \"Sex\", \"Bdate\", \"Relationship\"}, {",
          "        {\"333445555\", \"Alice\", \"F\", \"1986-04-05\", \"Daughter\"},",
          "        {\"333445555\", \"Theodore\", \"M\", \"1983-10-25\", \"Son\"},",
          "        {\"333445555\", \"Joy\", \"F\", \"1958-05-03\", \"Spouse\"},",
          "        {\"987654321\", \"Abner\", \"M\", \"1942-02-28\", \"Spouse\"},",
          "        {\"123456789\", \"Michael\", \"M\", \"1988-01-04\", \"Son\"},",
          "        {\"123456789\", \"Alice\", \"F\", \"1988-12-30\", \"Daughter\"},",
          "        {\"123456789\", \"Elizabeth\", \"F\", \"1967-05-05\", \"Spouse\"}",
          "    }),",
          "    Tipos = Table.TransformColumnTypes(Fonte, {{\"Essn\", type text}, {\"Dependent_name\", type text}, {\"Sex\", type text}, {\"Bdate\", type text}, {\"Relationship\", type text}})",
          "in",
          "    Tipos"
        ],
        "kind": "m",
        "lineageTag": "57af33aa-e142-47bb-9771-967b6b55b6d7"
      }
    ],
