            "dataType": "string",
            "lineageTag": "8159be86-6076-4df3-b1bf-a51881bea421",
            "sourceColumn": "Projeto",
            "summarizeBy": "none"
          },
          {
            "name": "DepartamentoProjeto",
            "dataType": "string",
            "lineageTag": "af0fc31d-846f-413f-bdc1-18524a374605",
            "sourceColumn": "DepartamentoProjeto",
            "summarizeBy": "none"
          },
          {
            "name": "SituacaoHoras",
            "dataType": "string",
            "lineageTag": "11624e4d-bf70-4f85-a416-6e6cee0f0683",
            "sourceColumn": "SituacaoHoras",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "ffae3f8f-b69d-4d19-9e5f-cfc5837b65e5",
        "measures": [
          {
            "name": "Horas registradas",
            "expression": "SUM(Assignments[Horas])",
            "formatString": "0.0",
            "lineageTag": "0cd3be96-2465-423d-98af-f338b3aaa386"
          },
          {
            "name": "Alocacoes",
            "expression": "COUNTROWS(Assignments)",
            "formatString": "0",
            "lineageTag": "19fd9758-3fa7-4345-87c3-7fcb61a3ea1e"
          }
        ],
        "partitions": [
          {
            "name": "Assignments",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Tipos = Table.TransformColumnTypes(raw_works_on,{{\"Pno\",Int64.Type},{\"Hours\",type number}}),",
                "    Emp = Table.NestedJoin(Tipos,{\"Essn\"},Employees,{\"EmployeeId\"},\"Emp\",JoinKind.LeftOuter),",
                "    Nomes = Table.ExpandTableColumn(Emp,\"Emp\",{\"Nome\",\"Departamento\",\"Gerente\"},{\"Colaborador\",\"DepartamentoColaborador\",\"Gerente\"}),",
                "    Proj = Table.NestedJoin(Nomes,{\"Pno\"},Projects,{\"ProjectId\"},\"Proj\",JoinKind.LeftOuter),",
                "    Projetos = Table.ExpandTableColumn(Proj,\"Proj\",{\"Projeto\",\"Departamento\"},{\"Projeto\",\"DepartamentoProjeto\"}),",
                "    Status = Table.AddColumn(Projetos,\"SituacaoHoras\",each if [Hours] = null then \"Horas ausentes\" else if [Hours] < 0 then \"Horas negativas\" else if [Hours] = 0 then \"Zero - revisar\" else \"Informadas\",type text),",
                "    Renomeia = Table.RenameColumns(Status,{{\"Essn\",\"EmployeeId\"},{\"Pno\",\"ProjectId\"},{\"Hours\",\"Horas\"}})",
                "in Renomeia"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "ManagerCounts",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "ManagerId",
            "dataType": "string",
