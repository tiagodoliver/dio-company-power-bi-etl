            "lineageTag": "15feb1cc-d01f-46e6-8515-e83b71a53c47",
            "sourceColumn": "DepartamentoColaborador",
            "summarizeBy": "none"
          },
          {
            "name": "Gerente",
            "dataType": "string",
            "lineageTag": "7aaae620-944f-4c05-acbc-c09d7cc6617f",
            "sourceColumn": "Gerente",
