          },
          {
            "name": "Folha salarial",
            "expression": "SUM(Employees[Salario])",
            "formatString": "#,0",
            "lineageTag": "4f4d5533-bb08-411b-a886-fa4afea719c1"
          },
          {
            "name": "Salario medio",
            "expression": "AVERAGE(Employees[Salario])",
            "formatString": "#,0.00",
